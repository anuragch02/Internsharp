@model InternshipModel
@{
    ViewBag.Title = "Internship Details";
}

<div class="bg-gradient-to-b from-primary-50 to-white py-12">
    <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
            <!-- Breadcrumb -->
            <div class="mb-8">
                <nav class="flex" aria-label="Breadcrumb">
                    <ol class="inline-flex items-center space-x-1 md:space-x-3">
                        <li class="inline-flex items-center">
                            <a href="/" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary-600">
                                <span class="material-symbols-outlined text-sm mr-2">home</span> Home
                            </a>
                        </li>
                        <li>
                            <div class="flex items-center">
                                <span class="text-gray-400 mx-2">/</span>
                                <a href="/internships" class="ml-1 text-sm font-medium text-gray-700 hover:text-primary-600">Internships</a>
                            </div>
                        </li>
                        <li aria-current="page">
                            <div class="flex items-center">
                                <span class="text-gray-400 mx-2">/</span>
                                <span class="ml-1 text-sm font-medium text-gray-500">@Model.Title</span>
                            </div>
                        </li>
                    </ol>
                </nav>
            </div>

            <!-- Title and Buttons -->
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-6 gap-4">
                <h1 class="text-3xl font-bold">@Model.Title</h1>
                <div class="flex flex-wrap gap-3">
                    <button class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 flex items-center">
                        <span class="material-symbols-outlined mr-2">bookmark</span> Save
                    </button>
                    <button class="px-4 py-2 bg-white border border-primary-600 text-primary-600 rounded-lg hover:bg-primary-50 flex items-center">
                        <span class="material-symbols-outlined mr-2">share</span> Share
                    </button>
                </div>
            </div>

            <!-- Main Content Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Left Column -->
                <div class="lg:col-span-2 space-y-8">
                    <!-- Internship Card -->
                    <div class="bg-white rounded-xl shadow-lg p-8 transition-transform hover:scale-[1.01] duration-300">
                        <!-- Company & Info -->
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex">
                                <div class="h-20 w-20 bg-primary-100 rounded-lg flex items-center justify-center mr-5 p-4">
                                    <span class="material-symbols-outlined text-5xl text-primary-600">business_center</span>
                                </div>
                                <div>
                                    <h2 class="text-xl font-semibold">@Model.CompanyName</h2>
                                    <p class="flex text-gray-600 text-sm items-center">
                                        <span class="material-symbols-outlined text-base mr-1">location_on</span> @Model.Location
                                    </p>
                                </div>
                            </div>
                            <div class="text-right">
                                <span class="bg-green-100 text-green-800 text-xs font-medium px-3 py-1 rounded-full">Active</span>
                                <p class="text-gray-500 text-sm mt-2">Posted 2 days ago</p>
                            </div>
                        </div>

                        <!-- Info Stats -->
                        <div class="flex flex-wrap sm:flex-nowrap gap-4 mb-6 w-full">
                            <div class="flex-1 bg-gray-50 p-6 rounded-xl shadow">
                                <p class="text-sm text-gray-500">Employment Type</p>
                                <p class="font-medium flex items-center mt-1">
                                    <span class="material-symbols-outlined text-gray-600 mr-1">schedule</span>
                                    @Model.InternshipType
                                </p>
                            </div>
                            <div class="flex-1 bg-gray-50 p-6 rounded-xl shadow">
                                <p class="text-sm text-gray-500">Duration</p>
                                <p class="font-medium flex items-center mt-1">
                                    <span class="material-symbols-outlined text-gray-600 mr-1">calendar_month</span>
                                    @Model.Duration
                                </p>
                            </div>
                            <div class="flex-1 bg-gray-50 p-6 rounded-xl shadow">
                                <p class="text-sm text-gray-500">Stipend</p>
                                <p class="font-medium flex items-center mt-1">
                                    <span class="material-symbols-outlined text-gray-600 mr-1">payments</span>
                                    @Model.Stipend
                                </p>
                            </div>
                        </div>

                        <!-- Full Description Sections -->
                        @if (!string.IsNullOrWhiteSpace(Model.FullDescriptionJson?.AboutRole))
                        {
                            <div class="mb-6">
                                <h3 class="text-lg font-semibold mb-2">About Role</h3>
                                <p class="text-gray-700">@Model.FullDescriptionJson.AboutRole</p>
                            </div>
                        }

                        @if (Model.FullDescriptionJson?.Responsibilities?.Any() == true)
                        {
                            <div class="mb-6">
                                <h3 class="text-lg font-semibold mb-2">Responsibilities</h3>
                                <ul class="list-disc list-outside  text-gray-700 space-y-1">
                                    @foreach (var item in Model.FullDescriptionJson.Responsibilities)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.FullDescriptionJson?.Requirements?.Any() == true)
                        {
                            <div class="mb-6">
                                <h3 class="text-lg font-semibold mb-2">Requirements</h3>
                                <ul class="list-disc list-outside  text-gray-700 space-y-1">
                                    @foreach (var item in Model.FullDescriptionJson.Requirements)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.FullDescriptionJson?.Benefits?.Any() == true)
                        {
                            <div>
                                <h3 class="text-lg font-semibold mb-2">Benefits</h3>
                                <ul class="list-disc list-outside  text-gray-700 space-y-1">
                                    @foreach (var item in Model.FullDescriptionJson.Benefits)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>

                <!-- Right Column -->
                <div class="space-y-6">
                    <div class="bg-white rounded-xl shadow-lg p-6 transition-transform hover:scale-[1.01] duration-300">
                        <h3 class="text-lg font-semibold mb-6">Apply Now</h3>
                        <a asp-controller="Students" asp-action="ApplicationSubmission" asp-route-id="@Model.ID"
                           class="block w-full px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 text-center mb-4">
                            <span class="material-symbols-outlined mr-2">send</span> Quick Apply
                        </a>
                        <a asp-controller="Students" asp-action="ResumeUpload"
                           class="block w-full px-6 py-3 border border-primary-600 text-primary-600 rounded-lg hover:bg-primary-50 text-center">
                            <span class="material-symbols-outlined mr-2">description</span> Apply with Resume
                        </a>
                    </div>

                    <div class="bg-white rounded-xl shadow-lg p-6">
                        <h3 class="text-lg font-semibold mb-4">Key Skills</h3>
                        <div class="pt-4 border-t border-gray-200">
                            <h4 class="font-medium mb-3">Do you have these skills?</h4>
                            <p class="text-sm text-gray-600 mb-4">Update your profile to showcase your matching skills to employers.</p>
                            <a href="#" class="text-primary-600 hover:text-primary-700 font-medium flex items-center">
                                Update Profile
                                <span class="material-symbols-outlined ml-1">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div> <!-- End Grid -->
        </div>
    </div>
</div>
